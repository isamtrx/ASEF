{
  "profile": "enterprise",
  "description": "Enterprise ASEF installation profile. Full governance with privacy, observability, risk register and audit evidence.",
  "required_layers": [
    "AGENTS.md",
    "directives",
    "agents",
    "orchestration",
    "skills",
    "tools",
    "contracts",
    "schemas",
    "policies",
    "registry",
    "execution",
    "memory",
    "artifacts",
    "runtime",
    "gates",
    "missions",
    "playbooks",
    "evaluations"
  ],
  "optional_layers": [
    "benchmarks",
    "config",
