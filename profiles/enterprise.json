  "additional_layers": {
    "privacy": "docs/security/SECURITY.md or equivalent privacy policy",
    "observability": "Structured logging in memory/ or runtime/",
    "release": "CHANGELOG.md with versioned releases",
    "risk_register": "memory/risks.jsonl or docs/governance/",
    "governance": "GOVERNANCE.md or docs/governance/",
    "audit_evidence": "artifacts/reports/ with evidence packages"
  }
}
