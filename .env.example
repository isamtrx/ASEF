# Copy this file to .env and fill in your values.
# .env is ignored by git.

# ─────────────────────────────────────────────
# OPTION A — Anthropic API (direct)
# ─────────────────────────────────────────────
# ASEF_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# Per-role model overrides (Anthropic model names):
# ASEF_MODEL_ARCHITECT=claude-opus-4-7
# ASEF_MODEL_DEVELOPER=claude-sonnet-4-6
# ASEF_MODEL_QA=claude-sonnet-4-6
# ASEF_MODEL_SECURITY=claude-sonnet-4-6
# ASEF_MODEL_DOCS=claude-haiku-4-5-20251001
# ASEF_MODEL_ORCHESTRATOR=claude-sonnet-4-6

# ─────────────────────────────────────────────
# OPTION B — GitHub Models (GitHub token, Claude Sonnet)
# https://github.com/marketplace/models
# ─────────────────────────────────────────────
ASEF_PROVIDER=github
GITHUB_TOKEN=ghp_...

# Default model for all roles (GitHub Models name):
ASEF_GITHUB_DEFAULT_MODEL=claude-sonnet-4-5

# Or override per role with GitHub Models names:
# ASEF_MODEL_ARCHITECT=claude-sonnet-4-5
# ASEF_MODEL_DEVELOPER=claude-sonnet-4-5
# ASEF_MODEL_QA=claude-sonnet-4-5
# ASEF_MODEL_SECURITY=claude-sonnet-4-5
# ASEF_MODEL_DOCS=claude-haiku-4-5
# ASEF_MODEL_ORCHESTRATOR=claude-sonnet-4-5

# ─────────────────────────────────────────────
# Paramètres communs
# ─────────────────────────────────────────────
# OPTIONAL — set to 0 to allow auto-merge without human approval (NOT recommended).
ASEF_REQUIRE_HUMAN_APPROVAL=1

# OPTIONAL — max agent iterations per gate before forced escalation.
ASEF_MAX_ITERATIONS=3

# OPTIONAL — wrap every agent shell command with a sandbox.
# Example: ASEF_SANDBOX_PREFIX="firejail --quiet --net=none"
ASEF_SANDBOX_PREFIX=
