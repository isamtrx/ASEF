{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill_output.schema.json",
  "title": "ASEF Skill Output",
  "type": "object",
  "required": ["skill_id", "agent_role", "task_id", "status"],
  "additionalProperties": true,
  "properties": {
    "skill_id": {
      "type": "string",
      "description": "ID du skill exécuté (ex: repo_audit, code_review)"
    },
    "agent_role": {
      "type": "string",
      "enum": ["orchestrator", "architect", "developer", "qa", "security", "docs"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9a-f]{8}$"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "escalated", "skipped"]
    },
    "output": {
      "type": "string",
      "description": "Résumé de l'exécution du skill"
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Chemins des artifacts produits"
    },
    "evidence": {
      "type": "object",
      "description": "Preuves d'exécution (logs, exit codes, file checksums)"
    }
  }
}
