{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestration_plan.schema.json",
  "title": "ASEF Orchestration Plan",
  "type": "object",
  "required": ["task_id", "task_type", "planned_agents", "planned_gates", "approval_required"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9a-f]{8}$"
    },
    "task_type": {
      "type": "string",
      "enum": ["bugfix", "feature", "review", "audit", "release", "security", "documentation", "governance"]
    },
    "planned_agents": {
      "type": "array",
      "items": {"type": "string", "enum": ["orchestrator", "architect", "developer", "qa", "security", "docs"]},
      "minItems": 1
    },
    "planned_skills": {
      "type": "array",
      "items": {"type": "string"}
    },
    "planned_tools": {
      "type": "array",
      "items": {"type": "string"}
    },
    "planned_gates": {
      "type": "array",
      "items": {"type": "string", "pattern": "^G[0-7]$"},
      "minItems": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "estimated_steps": {
      "type": "integer",
      "minimum": 1
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
