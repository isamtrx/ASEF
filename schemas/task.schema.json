{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task.schema.json",
  "title": "ASEF Task",
  "type": "object",
  "required": ["task_id", "description"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9a-f]{8}$",
      "description": "Identifiant unique de la tâche"
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "description": "Description de la tâche (≥ 5 mots)"
    },
    "task_type": {
      "type": "string",
      "enum": ["bugfix", "feature", "review", "audit", "release", "security", "documentation", "governance"],
      "description": "Type de tâche (peut être omis, sera classifié)"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester": {
      "type": "string"
    }
  }
}
